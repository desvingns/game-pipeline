{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GP assignment",
  "type": "object",
  "required": [
    "role",
    "goal",
    "tool",
    "complexity",
    "context",
    "write_paths"
  ],
  "properties": {
    "role": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "tool": {
      "type": "string",
      "enum": [
        "codex",
        "claude"
      ]
    },
    "complexity": {
      "type": "string",
      "enum": [
        "simple",
        "complex",
        "expert"
      ]
    },
    "context": {
      "type": "array",
      "minItems": 1
    },
    "write_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
