{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GP migration",
  "type": "object",
  "required": [
    "version",
    "moves"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "moves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target",
          "sha256"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
