{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GP model-policy",
  "type": "object",
  "required": [
    "version",
    "mode",
    "tiers",
    "claude",
    "max_concurrent_agents",
    "max_attempts_per_stage",
    "max_delegation_depth",
    "context_chars"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "tiered",
        "inherit"
      ]
    },
    "tiers": {
      "type": "object",
      "required": [
        "simple",
        "complex",
        "expert"
      ]
    },
    "claude": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "tiered",
            "auto",
            "native"
          ]
        },
        "tiers": {
          "type": "object"
        },
        "role_tiers": {
          "type": "object"
        },
        "max_turns": {
          "type": "object"
        },
        "orchestrator": {
          "type": "object"
        }
      }
    },
    "max_concurrent_agents": {
      "type": "integer",
      "minimum": 1
    },
    "max_attempts_per_stage": {
      "type": "integer",
      "minimum": 1
    },
    "max_delegation_depth": {
      "type": "integer",
      "minimum": 1
    },
    "context_chars": {
      "type": "integer",
      "minimum": 1
    }
  }
}
