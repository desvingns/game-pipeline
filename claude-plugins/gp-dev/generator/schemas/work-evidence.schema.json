{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GP evidence",
  "type": "object",
  "required": [
    "run_id",
    "source_sha256",
    "acceptance"
  ],
  "properties": {
    "run_id": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "evidence",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass"
            ]
          },
          "evidence": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        }
      }
    },
    "manual": {
      "type": "array"
    }
  }
}
